# Linq (Agent 2) — API auth for sending iMessage replies
LINQ_API_KEY=

# Linq (Agent 2) — optional webhook signature verification
LINQ_WEBHOOK_SECRET=

# Runware (Agent 3) — OpenAI-compatible API key
RUNWARE_API_KEY=

# Runware (Agent 3) — OpenAI-compatible base URL
RUNWARE_BASE_URL=https://api.runware.ai/v1

# Runware (Agent 3) — model id (default gpt-5.6-luna)
RUNWARE_MODEL=gpt-5.6-luna

# Public tunnel URL for Linq webhook registration notes (Agent 5)
PUBLIC_BASE_URL=

# Terac confirm-then-act (default dry-run — no live API calls)
TERAC_API_KEY=
TERAC_BASE_URL=https://terac.com/api/external/v2
TERAC_DRY_RUN=true
# dry-run decision when TERAC_DRY_RUN=true: approve | reject
TERAC_DRY_RUN_DECISION=approve
TERAC_PROJECT_ID=
TERAC_WEBHOOK_SECRET=
# When true, non-nudge move_robot calls require prior Terac confirmation
TERAC_REQUIRE_CONFIRMATION=false
TERAC_EXPERT_ROLE=robotics / manufacturing operator
